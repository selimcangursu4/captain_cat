# Mağaza paketi (npm run android:release / mobile:build) ayarları.
# Bu dosyayı .env.production.local olarak kopyalayıp doldurun (git'e girmez).

# Oyun sunucusunun herkese açık HTTPS adresi (IP ya da localhost olmaz).
VITE_API_URL=https://api.ornek-alanadiniz.com

# RevenueCat genel (public) SDK anahtarları: Android goog_..., iOS appl_...
VITE_REVENUECAT_ANDROID_KEY=
VITE_REVENUECAT_IOS_KEY=
