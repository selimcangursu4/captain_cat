# Sunucu ayarları. Bu dosyayı .env olarak kopyalayın (.env git'e girmez).

# docker-compose.yml'deki yerel PostgreSQL (port 5433)
DATABASE_URL="postgresql://kaptan:kaptan_dev_password@localhost:5433/kaptan_pati?schema=public"

# Oyun sunucusunun portu (istemci varsayılan olarak bu portu kullanır)
PORT=8787

# 1: geliştirici komutlarına (+yıldız, seviye atla) ve doğrulamasız deneme alımlarına izin ver. Yayında 0.
DEV_COMMANDS=1

# İzin verilen kaynaklar (virgülle). * = hepsi (geliştirme)
CORS_ORIGINS=*

# Oturum süresi (gün; her kullanımda uzar)
SESSION_DAYS=90

# Kaba kuvvet sınırları: IP başına saatte kayıt, IP+e-posta başına 10 dakikada giriş denemesi.
# Yayında 5 ve 10 yeterli; geliştirmede (otomatik testler çok hesap açar) yüksek tutulabilir.
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_10MIN=10


# RevenueCat gizli anahtarı (sk_…): mağaza ödemelerini sunucuda doğrulamak için. Boşsa gerçek alım kabul edilmez.
REVENUECAT_SECRET_KEY=

# İstemci (Vite) — RevenueCat genel anahtarları (Android: goog_…, iOS: appl_…). Derlemeden önce tanımlanır.
VITE_REVENUECAT_ANDROID_KEY=
VITE_REVENUECAT_IOS_KEY=
